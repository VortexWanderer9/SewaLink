# ================================
# BACKEND (.env -> /backend/.env)
# ================================

# Runtime
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sewalink?schema=public"

# JWT Authentication
JWT_SECRET=please-change-this-super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=please-change-this-super-secret-refresh-key-long
JWT_REFRESH_EXPIRES_IN=30d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# File uploads
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE=10485760

# =====================================
# NEPALI PAYMENT GATEWAYS
# Leave as test values for local dev
# =====================================

# eSewa
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=test_secret_key
ESEWA_BASE_URL=https://uat.esewa.com.np

# Khalti
KHALTI_PUBLIC_KEY=test_public_key_xxxxxxxxxxxxx
KHALTI_SECRET_KEY=test_secret_key_xxxxxxxxxxxxx
KHALTI_BASE_URL=https://a.khalti.com/api/v2

# IME Pay
IMEPAY_MERCHANT_ID=TEST_MERCHANT
IMEPAY_SECRET_KEY=TEST_SECRET
IMEPAY_BASE_URL=https://stg.imepay.com.np/api/v1

# Optional: AWS S3 for document storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# ================================
# FRONTEND (NEXT.js)
# ================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Docker (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sewalink
PG_PORT=5432
BACKEND_PORT=3001
FRONTEND_PORT=3000
