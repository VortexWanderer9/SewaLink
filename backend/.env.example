# Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sewalink?schema=public"

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:3000

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Payment Gateways
ESEWA_MERCHANT_ID=test_merchant_id
ESEWA_SECRET_KEY=test_secret_key
ESEWA_BASE_URL=https://uat.esewa.com.np

KHALTI_PUBLIC_KEY=test_public_key
KHALTI_SECRET_KEY=test_secret_key
KHALTI_BASE_URL=https://a.khalti.com/api/v2

IMEPAY_MERCHANT_ID=test_merchant_id
IMEPAY_SECRET_KEY=test_secret_key
IMEPAY_BASE_URL=https://stg.imepay.com.np/api/v1

# AWS S3 (optional, for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
